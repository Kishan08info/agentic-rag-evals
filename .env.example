# Copy to .env and fill in to enable generative answers.
# Without these, the agent runs fully offline using the extractive fallback.

# Any OpenAI-compatible chat-completions endpoint:
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Retrieval / agent tuning
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K=5
ROUTE_THRESHOLD=0.30
ANSWER_THRESHOLD=0.30
